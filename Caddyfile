# TokenMP Dashboard —— FrankenPHP (Caddy + PHP) 运行时配置
# https://frankenphp.dev/docs/config

{
	skip_install_trust
	admin off
	frankenphp
}

{$SERVER_NAME::80} {
	root * {$SERVER_ROOT:/app/public}
	encode zstd br gzip

	# API 请求交给 ThinkPHP（/index.php?s=path 兼容 FrankenPHP 未设 PATH_INFO）
	@api path /api/v1/*
	handle @api {
		rewrite * /index.php?s={path}&{query}
		php_server
	}

	# 文档站（VitePress 产物 public/docs）：cleanUrls 无 .html 后缀，需回退 {path}.html
	handle /docs/* {
		header /docs/assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html
		file_server
	}

	# 其余前端路由：真实文件直接返回，否则回退 SPA index.html（支持深层路由刷新）
	handle {
		# 带内容哈希的静态资源：永久缓存（文件名变即失效）
		@assets path /static/assets/* /docs/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# 其余一律 no-cache：SPA 入口经 try_files 从任意路由回退到 index.html，
		# 请求路径不是 /static/index.html，按路径写死 no-cache 永远不命中，
		# 浏览器会走启发式缓存继续吃旧 bundle（发新版后页面不更新）。
		@not_assets not path /static/assets/* /docs/assets/*
		header @not_assets Cache-Control "no-cache"
		try_files {path} /static/index.html
		file_server
	}

	# 未命中静态文件渲染 VitePress 404 页（保留状态码；SPA handle 有兜底，实际仅 /docs/* 会走到）
	handle_errors {
		rewrite * /docs/404.html
		file_server
	}
}
