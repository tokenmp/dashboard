# TokenMP Dashboard —— FrankenPHP (Caddy + PHP) 运行时配置
# https://frankenphp.dev/docs/config

{
	skip_install_trust
	admin off
	frankenphp
}

{$SERVER_NAME::80} {
	root * {$SERVER_ROOT:/app/public}
	encode zstd br gzip

	# API 请求交给 ThinkPHP（/index.php?s=path 兼容 FrankenPHP 未设 PATH_INFO）
	@api path /api/v1/*
	handle @api {
		rewrite * /index.php?s={path}&{query}
		php_server
	}

	# 其余前端路由：真实文件直接返回，否则回退 SPA index.html（支持深层路由刷新）
	handle {
		try_files {path} /static/index.html
		file_server
	}
}
