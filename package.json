{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "TokenMP Dashboard — ThinkPHP 8 + React (Vite)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"php think run\" \"npm --prefix web run dev\"",
    "dev:api": "php think run",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "lint": "npm --prefix web run lint",
    "install:web": "npm install --prefix web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
