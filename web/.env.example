# 前端环境变量模板
#
# 用法：复制为实际的环境文件（这些文件不会被提交）
#   cp .env.example .env.development   # 开发模式（npm run dev）
#   cp .env.example .env.production    # 生产构建（npm run build）
#
# 说明：以下变量在代码中均有默认值，留空也能正常运行；
#       仅在需要覆盖默认值时才配置。

# axios 请求基础路径（默认 /api）
VITE_API_BASE_URL=/api

# 开发期 Vite 代理目标，指向本地 ThinkPHP（默认 http://localhost:8000）
# 仅开发模式使用，生产构建可忽略
VITE_API_TARGET=http://localhost:8000
