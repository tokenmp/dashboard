# 版本控制
.git
.gitignore

# 依赖（镜像内重新安装，避免带入宿主机的不一致产物）
web/node_modules
vendor

# 前端构建产物（镜像内由 Vite 重新构建）
web/dist
public/static/assets
public/static/index.html

# 运行时缓存
runtime/cache
runtime/log
runtime/temp
runtime/session
runtime/*

# 环境变量（绝不进镜像，运行时注入）
.env
.env.*
!.example.env

# 日志
*.log

# 编辑器 / 系统
.vscode
.idea
.DS_Store
Thumbs.db

# Docker / CI 自身（无需进入镜像）
Dockerfile
.dockerignore
docker-compose*.yml
.github

# 文档
README.md
LICENSE.txt

# 文档站构建产物与依赖（镜像内由 VitePress 重新构建）
docs-site/node_modules
docs-site/.vitepress/dist
docs-site/.vitepress/cache
