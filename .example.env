APP_DEBUG = true

# 默认数据库连接的驱动：36 个 model 全部走 pgsql。
# 刻意设为 pgsql（而不是模板历史默认的 mysql），防止漏网的 Db:: 查询打到 MySQL。
DB_DRIVER = pgsql

# 传统 MySQL 连接（config/database.php 的 'mysql'）。
# 当前代码已不使用，保留仅为兼容框架默认配置。
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

# PostgreSQL 连接（app\model 模型使用，对应 config/database.php 的 'pgsql'）
# ⚠️ 库名用 tokenmp（当前正式库 / 本地栈同名）。
#    tokenmp_prod 是已废弃的「蓝栈」旧库，正在下线，不要再连它。
PG_HOST = 127.0.0.1
PG_DB = tokenmp
PG_USER = postgres
PG_PASS =
PG_PORT = 5432
PG_CHARSET = utf8
# 会话时区：须与 app.default_timezone 一致（默认 Asia/Shanghai，一般无需设置）。
# 不一致会导致「今日/趋势」类查询边界错位、当天数据漏计（有回归测试守卫）。
PG_TIMEZONE = Asia/Shanghai

DEFAULT_LANG = zh-cn

# JWT 配置
JWT_SECRET = please-change-this-to-a-random-string
JWT_EXPIRE = 604800
JWT_PREFIX = Bearer

# 跨服务共享密钥（⚠️ 须与 executor 容器完全一致，否则双方 API Key / 上游 Key 无法互验）
# 生产环境改由 /opt/tokenmp/secrets.env 统一注入（docker compose env_file），此处仅作本地开发占位。
# 生成： bash scripts/gen-secrets.sh .env.local
API_KEY_PEPPER =
MASTER_ENCRYPTION_KEY =

# 密码传输加密（一次性 RSA 公钥）
# AUTH_KEY_TTL       临时私钥在缓存中的存活秒数
# AUTH_KEY_RATE_LIMIT 取 key 端点每 IP 每分钟限流次数（防 RSA keygen DoS）
AUTH_KEY_TTL = 300
AUTH_KEY_RATE_LIMIT = 20
