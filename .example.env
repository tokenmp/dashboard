APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

# PostgreSQL 连接（app\model 模型使用，对应 config/database.php 的 'pgsql'）
PG_HOST = 127.0.0.1
PG_DB = tokenmp_prod
PG_USER = postgres
PG_PASS =
PG_PORT = 5432
PG_CHARSET = utf8

DEFAULT_LANG = zh-cn

# JWT 配置
JWT_SECRET = please-change-this-to-a-random-string
JWT_EXPIRE = 604800
JWT_PREFIX = Bearer
