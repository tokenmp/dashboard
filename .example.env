APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

# PostgreSQL 连接（app\model 模型使用，对应 config/database.php 的 'pgsql'）
PG_HOST = 127.0.0.1
PG_DB = tokenmp_prod
PG_USER = postgres
PG_PASS =
PG_PORT = 5432
PG_CHARSET = utf8

DEFAULT_LANG = zh-cn

# JWT 配置
JWT_SECRET = please-change-this-to-a-random-string
JWT_EXPIRE = 604800
JWT_PREFIX = Bearer

# 跨服务共享密钥（⚠️ 须与 executor 容器完全一致，否则双方 API Key / 上游 Key 无法互验）
# 生产环境改由 /opt/tokenmp/secrets.env 统一注入（docker compose env_file），此处仅作本地开发占位。
# 生成： bash scripts/gen-secrets.sh .env.local
API_KEY_PEPPER =
MASTER_ENCRYPTION_KEY =

# 密码传输加密（一次性 RSA 公钥）
# AUTH_KEY_TTL       临时私钥在缓存中的存活秒数
# AUTH_KEY_RATE_LIMIT 取 key 端点每 IP 每分钟限流次数（防 RSA keygen DoS）
AUTH_KEY_TTL = 300
AUTH_KEY_RATE_LIMIT = 20
