", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "sans", "scale": 1}, "parentId": "page:page", "index": "aIu76", "typeName": "shape"}, {"x": 0, "y": 90, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:a-track1", "type": "geo", "props": {"w": 640, "h": 60, "geo": "rectangle", "dash": "dashed", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "semi", "size": "s", "font": "mono", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "订阅轨 coding：计量=请求次数，扣 request_weight × multiplier"}]}]}}, "parentId": "page:page", "index": "a43jv", "typeName": "shape"}, {"x": 220, "y": 2088, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-w-Windows", "type": "geo", "props": {"w": 430, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "四维窗口 + 短期窗重置"}]}]}}, "parentId": "page:page", "index": "b033VI", "typeName": "shape"}, {"x": 940, "y": 1345, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:cr4", "type": "arrow", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "solid", "size": "m", "fill": "none", "color": "black", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 70, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "refund"}]}]}, "labelPosition": 0.5, "font": "sans", "scale": 1}, "parentId": "page:page", "index": "afArA", "typeName": "shape"}, {"x": 1160, "y": 255, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ar6", "type": "arrow", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "solid", "size": "m", "fill": "none", "color": "black", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 80, "y": 55}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "sans", "scale": 1}, "parentId": "page:page", "index": "aJxdA", "typeName": "shape"}, {"x": 760, "y": 90, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:a-track2", "type": "geo", "props": {"w": 760, "h": 60, "geo": "rectangle", "dash": "dashed", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "semi", "size": "s", "font": "mono", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "按量轨 wallet：计量=人民币元，扣 Σ(tokens × 矩阵单价) × multiplier"}]}]}}, "parentId": "page:page", "index": "aCc9A", "typeName": "shape"}, {"x": 0, "y": 380, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:a-inv", "type": "geo", "props": {"w": 1760, "h": 720, "geo": "rectangle", "dash": "dashed", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "mono", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "不变式（TLC 已验证）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  NoOverdraft             balance_cny ≥ 0 ∧ frozen_cny ≥ 0"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  NoOversell              subUsed + subHold ≤ 限额"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  HoldCoversReservation   未结清钱包预留 ≤ frozen_cny"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  Conservation            balance + frozen + spent = 初始总额"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ChargeIdempotent        同一请求不重复扣费"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ReservationsResolved    每个 reserved 最终 done 或 released（活性）"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "反例（原稿）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  W1_naive        ❌ NoOverdraft    预留 est=0 → 结算 actual=3 → balance = -1"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  W2_walletOnly   ❌ NoOversell     reserve 权重 1 → finalize 权重 3 → 4 > 3"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  L_no_expire     ❌ 时序性质        复核拒绝的预留永久悬挂"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "修订规则"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ① 钱包结算复核：balance + 本预留冻结额 ≥ 实际金额                      （§3.2）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ② 权重 / 倍率在 reserve 时快照（或结算按时点口径复核）                 （§3.1）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ③ 结算复核必须配 TTL 过期释放，否则预留永久泄漏                        （§6.3）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ④ 冻结语义：balance=可用 / frozen=预扣；预留=搬运、结算=销毁、释放=回搬  （§3.2）"}]}]}}, "parentId": "page:page", "index": "aKqVn", "typeName": "shape"}, {"x": 1260, "y": 2316, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-g-MarketSettlement", "type": "geo", "props": {"w": 560, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-green", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "M_safe ✅"}]}]}}, "parentId": "page:page", "index": "b0HumX", "typeName": "shape"}, {"x": 660, "y": 2012, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-b-Fallback", "type": "geo", "props": {"w": 590, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-red", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "F_leaky ❌NoLeak"}]}]}}, "parentId": "page:page", "index": "b00vuI", "typeName": "shape"}, {"x": 2820, "y": 1080, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:d-supplier", "type": "geo", "props": {"w": 320, "h": 110, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "供应商入账"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "marketplace_settlement"}]}]}}, "parentId": "page:page", "index": "alKhI", "typeName": "shape"}, {"x": 660, "y": 2164, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-b-Liveness", "type": "geo", "props": {"w": 590, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-red", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "L_no_expire ❌时序性质"}]}]}}, "parentId": "page:page", "index": "b081sI", "typeName": "shape"}, {"x": 0, "y": 1936, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-m-Topup", "type": "geo", "props": {"w": 210, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "mono", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Topup"}]}]}}, "parentId": "page:page", "index": "auzV9", "typeName": "shape"}, {"x": 470, "y": 1300, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:c-paid", "type": "geo", "props": {"w": 170, "h": 90, "geo": "rectangle", "dash": "solid", "growY": 2, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "paid"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(回调成功)"}]}]}}, "parentId": "page:page", "index": "aZQhX", "typeName": "shape"}, {"x": 220, "y": 1860, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-w-Wallet", "type": "geo", "props": {"w": 430, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "双轨预留/结算/释放 + 并发"}]}]}}, "parentId": "page:page", "index": "ar9bj", "typeName": "shape"}, {"x": 1260, "y": 2240, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-g-QuotaDisplay", "type": "geo", "props": {"w": 560, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-green", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Q_min ✅"}]}]}}, "parentId": "page:page", "index": "b0DPRE", "typeName": "shape"}, {"x": 660, "y": 2316, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-b-MarketSettlement", "type": "geo", "props": {"w": 590, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-red", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "M_dup ❌SettlementOnce · M_reversal ❌NoNegativeAvail"}]}]}}, "parentId": "page:page", "index": "b0GEhf", "typeName": "shape"}, {"x": 220, "y": 2392, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-w-WindowModels", "type": "geo", "props": {"w": 430, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "独立窗口 vs 周期套住短窗"}]}]}}, "parentId": "page:page", "index": "b0JSZr", "typeName": "shape"}, {"x": 220, "y": 2544, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-w-CrossLedger", "type": "geo", "props": {"w": 430, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "消费者扣款 vs 供应商入账"}]}]}}, "parentId": "page:page", "index": "b0Rpyz", "typeName": "shape"}, {"x": 0, "y": 2846, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:f-note", "type": "geo", "props": {"w": 1820, "h": 560, "geo": "rectangle", "dash": "dashed", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "mono", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "§3.1  订阅权重 / 倍率在 reserve 时快照（或结算按时点口径复核）              ← W2_walletOnly"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§3.1  短期窗重置只影响 5h/周；周期与总量用单调累计约束                      ← N_buggy"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§3.2  钱包结算前复核 balance + 本预留冻结额 ≥ 实际金额                      ← W1_naive"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§3.2  冻结语义：balance=可用 / frozen=预扣；预留=搬运、结算=销毁、释放=回搬   ← 定义"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§6.1  候选回退每次尝试必须单事务原子，失败不留痕                            ← F_leaky"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§6.2  消费者扣款与供应商入账必须同事务（或 outbox）                          ← X_separate"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§6.3  结算复核必须配 TTL 过期释放，否则预留永久泄漏                          ← L_no_expire"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§6.4  免扣路径仅在未结算时生效 + 必须释放预留 + 已结算幂等不退款              ← E_leak / E_late"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§7.4  退款有界：只退未消费部分                                              ← T1_naive"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§7.5  幂等键规范  req:{id}:charge / order:{id}:credit 等"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§7.6  市场结算 UNIQUE(request_log_id) 承载性；回滚只回滚未提现部分           ← M_dup / M_reversal"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§8    展示口径 = 四维窗口剩余最小值（不得默认取 windows[0]）                 ← Q_cycle_first"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§3.1  窗口语义必须定死一种并写入代码注释                                    ← WM_samecapacity"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "§3.1  预留向上取整、结算按精确值；不得预留向下 + 结算向上而无复核            ← R_up_down / R_down_up"}]}]}}, "parentId": "page:page", "index": "b0ZBeM", "typeName": "shape"}, {"x": 2020, "y": 300, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:b-plat", "type": "geo", "props": {"w": 440, "h": 110, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "yellow", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "L2  平台默认价"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "model_prices  (plan_id IS NULL)"}]}]}}, "parentId": "page:page", "index": "aNPpr", "typeName": "shape"}, {"x": 230, "y": 1300, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:c-pending", "type": "geo", "props": {"w": 170, "h": 90, "geo": "rectangle", "dash": "solid", "growY": 2, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "pending"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(下单)"}]}]}}, "parentId": "page:page", "index": "aYrbM", "typeName": "shape"}, {"x": 2560, "y": 300, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:b-mult", "type": "geo", "props": {"w": 400, "h": 110, "geo": "rectangle", "dash": "solid", "growY": 12, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "orange", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "price_multiplier_rules"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "side=user → × 基础价"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "side=upstream → 仅报表"}]}]}}, "parentId": "page:page", "index": "aQ0bb", "typeName": "shape"}, {"x": 2020, "y": 1230, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:d-note", "type": "geo", "props": {"w": 1120, "h": 380, "geo": "rectangle", "dash": "dashed", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "mono", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "现状：请求完成路径分 3 次独立写，不在同一事务"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ① FinalizeReservation        → usage_ledger(charge)          消费者扣"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ② UpdateRequestLog           → request_logs 终态"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  ③ FinalizeMarketplaceSettlement → 供应商入账"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "反例  X_separate  ❌ LedgerPairing"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  消费者已扣、供应商未入账 → 供应者被短付"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "⚠️ 全局资金守恒仍成立（钱卡在 platform holding），常规对账监控发现不了"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "规则：消费者扣款 + 供应商入账必须同一事务（或 outbox）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "      对账补偿 worker 只能做 eventual 修复，不得作为唯一保障"}]}]}}, "parentId": "page:page", "index": "ao0Xn", "typeName": "shape"}, {"x": 0, "y": -140, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:t0", "type": "text", "props": {"color": "black", "size": "xl", "w": 8, "font": "sans", "textAlign": "start", "autoSize": true, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "TokenMP 计费 / 定价 / 充值重设计 —— TLA+ 形式化验证逻辑图"}]}]}}, "parentId": "page:page", "index": "a1X6Q", "typeName": "shape"}, {"x": 0, "y": 2620, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-m-Rounding", "type": "geo", "props": {"w": 210, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "mono", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rounding"}]}]}}, "parentId": "page:page", "index": "b0UrxM", "typeName": "shape"}, {"x": 2020, "y": 630, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:b-note", "type": "geo", "props": {"w": 940, "h": 300, "geo": "rectangle", "dash": "dashed", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "semi", "size": "s", "font": "mono", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "最终扣费"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  订阅轨： request_weight(矩阵) × multiplier"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  钱包轨： Σ(tokens × 矩阵单价) × multiplier"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "倍率分工（决策 D9）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  矩阵 / 平台价  = 基础价（稳定）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  倍率            = 时段 / 活动 / 渠道调整（动态）"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "  路由成本价      = 只做毛利核算，绝不参与用户扣费"}]}, {"type": "paragraph"}, {"type": "paragraph", "content": [{"type": "text", "text": "解析链： L1 命中 → 用 L1；缺失 → L2；L1/L2 都缺 → 拒绝计费"}]}]}}, "parentId": "page:page", "index": "aVLI2", "typeName": "shape"}, {"x": 0, "y": -60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:t1", "type": "text", "props": {"color": "grey", "size": "m", "w": 8, "font": "sans", "textAlign": "start", "autoSize": true, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11 个模型 · 30 组配置 · TLC 穷举；红=原稿被反驳，绿=修订通过"}]}]}}, "parentId": "page:page", "index": "a2kkI", "typeName": "shape"}, {"x": 220, "y": 190, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:a-res1", "type": "geo", "props": {"w": 180, "h": 90, "geo": "rectangle", "dash": "solid", "growY": 2, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "reserved"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(冻结次数)"}]}]}}, "parentId": "page:page", "index": "a6k8b", "typeName": "shape"}, {"x": 660, "y": 2240, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:e-b-QuotaDisplay", "type": "geo", "props": {"w": 590, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "light-red", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Q_cycle_first ❌DisplayAccurate"}]}]}}, "parentId": "page:page", "index": "b0CaWv", "typeName": "shape"}, {"x": 220, "y": 2468, "ro